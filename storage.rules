rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Direct email-based admin check for reliability in Storage rules
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'khalil@adityagreenenergy.com' || 
        request.auth.token.email == 'prafulrana143@gmail.com'
      );
    }

    // Rules for Site Documents (Shared project folders)
    match /site_documents/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Rules for user-specific and temporary uploads
    // Simplifed to allow all authenticated users to write to the uploads directory
    match /uploads/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}