rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an Admin or Super Admin
    function isAdmin() {
      let superAdminEmails = [
        'khalil@adityagreenenergy.com',
        'prafulrana143@gmail.com'
      ];
      // Using email check as primary and firestore check as secondary
      return isSignedIn() && (
        request.auth.token.email in superAdminEmails || 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'Admin'
      );
    }

    // Rules for Site Documents (Shared project folders)
    // Using recursive wildcard {allPaths=**} to support subfolders and nested files
    match /site_documents/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Rules for user-specific uploads (PtW, Movements, etc.)
    // Explicit userId matching for primary security
    match /uploads/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Catch-all for any missed upload paths to prevent "unauthorized" errors during submission
    // This ensures that even if a path segment is structured differently, authenticated users can still upload
    match /uploads/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}