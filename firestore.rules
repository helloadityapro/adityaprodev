
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Direct UID check for super admins
      let superAdminUids = ['dhHhKwUb4DNWllhoxgiFX0QeA6j1'];
      let superAdminEmails = ['khalil@adityagreenenergy.com', 'prafulrana143@gmail.com'];
      
      let userEmail = request.auth.token.get('email', '').lower();
      let isSuperAdmin = request.auth.uid in superAdminUids || userEmail in superAdminEmails;
                         
      let hasAdminRole = exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'Admin';
                         
      return isSignedIn() && (isSuperAdmin || hasAdminRole);
    }

    function isSiteManager() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'Site Manager';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        // Case 1: Site Manager updating their subordinate
        (isSiteManager() && 
         resource.data.get('siteManagerId', '') == request.auth.uid) ||
        // Case 2: User updating ONLY totalPoints for their assigned manager (Reward points logic)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPoints']) &&
          (
            // Target is the manager of the requester
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('siteManagerId', '') == userId
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid ||
        (isSiteManager() && resource.data.get('siteManagerId', '') == request.auth.uid)
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid ||
        (isSiteManager() && resource.data.get('siteManagerId', '') == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /site_visits/{visitId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.managerId == request.auth.uid ||
        resource.data.get('siteManagerId', '') == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.managerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (settingId == 'counters' && isSignedIn());
    }

    match /permits_to_work/{permitId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.siteEngineerId == request.auth.uid || 
        resource.data.get('siteManagerId', '') == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.siteEngineerId == request.auth.uid || 
        resource.data.get('siteManagerId', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /dprs/{dprId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.get('siteManagerId', '') == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.get('siteManagerId', '') == request.auth.uid
      );
    }

    match /requirements/{reqId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.get('siteManagerId', '') == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.get('siteManagerId', '') == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.get('siteManagerId', '') == request.auth.uid));
    }

    match /material_movements/{movementId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.get('siteManagerId', '') == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.get('siteManagerId', '') == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.get('siteManagerId', '') == request.auth.uid));
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.assignedToId == request.auth.uid || 
        resource.data.assignedById == request.auth.uid ||
        (isSiteManager() && exists(/databases/$(database)/documents/users/$(resource.data.assignedToId)) && get(/databases/$(database)/documents/users/$(resource.data.assignedToId)).data.get('siteManagerId', '') == request.auth.uid)
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.assignedToId == request.auth.uid || 
        resource.data.assignedById == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /site_documents/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uploadedById == request.auth.uid);
    }

    match /lms_courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lms_modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lms_quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lms_progress/{progressId} {
      allow read: if isSignedIn() && (isAdmin() || progressId.split('_')[0] == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /otp_verifications/{otpId} {
      allow read, write: if true;
    }

    match /cleanup_requests/{requestId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /redemption_requests/{requestId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /projects/{projectId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /sites/{siteId} { allow read: if isSignedIn(); allow write: if isAdmin() || isSiteManager(); }
    match /ptw_types/{ptwTypeId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /notifications/{notifId} { allow read, write: if isSignedIn(); }
    match /point_adjustment_requests/{requestId} { allow read, write: if isAdmin(); }
  }
}
