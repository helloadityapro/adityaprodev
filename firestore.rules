
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let superAdminEmails = [
        'khalil@adityagreenenergy.com',
        'prafulrana143@gmail.com'
      ];
      return isSignedIn() && (request.auth.token.email in superAdminEmails || getUserData().role == 'Admin');
    }

    function isSiteManager() {
      return isSignedIn() && getUserData().role == 'Site Manager';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isSiteManager() && get(/databases/$(database)/documents/users/$(userId)).data.siteManagerId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /permits_to_work/{permitId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.siteEngineerId == request.auth.uid || 
        resource.data.siteManagerId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.siteEngineerId == request.auth.uid || 
        resource.data.siteManagerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /dprs/{dprId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.siteManagerId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.siteManagerId == request.auth.uid
      );
    }

    match /requirements/{reqId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.siteManagerId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.siteManagerId == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.siteManagerId == request.auth.uid));
    }

    match /material_movements/{movementId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.siteManagerId == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.siteManagerId == request.auth.uid
      );
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.siteManagerId == request.auth.uid));
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.assignedToId == request.auth.uid || 
        resource.data.assignedById == request.auth.uid ||
        (isSiteManager() && get(/databases/$(database)/documents/users/$(resource.data.assignedToId)).data.siteManagerId == request.auth.uid)
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() || 
        resource.data.assignedToId == request.auth.uid || 
        resource.data.assignedById == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /site_documents/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uploadedById == request.auth.uid);
    }

    match /lms_courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lms_modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lms_quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lms_progress/{progressId} {
      // Allow read if the progress document belongs to the user (identified by ID prefix) or they are an admin
      allow read: if isSignedIn() && (isAdmin() || progressId.split('_')[0] == request.auth.uid);
      // Allow write if the user is the owner of the progress data
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /otp_verifications/{otpId} {
      allow read, write: if true;
    }

    match /projects/{projectId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /sites/{siteId} { allow read: if isSignedIn(); allow write: if isAdmin() || isSiteManager(); }
    match /ptw_types/{ptwTypeId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /notifications/{notifId} { allow read, write: if isSignedIn(); }
    match /point_adjustment_requests/{requestId} { allow read, write: if isAdmin(); }
  }
}
