
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function isAdmin() {
      let userEmail = request.auth.token.get('email', '').lower();
      let isSuperAdmin = userEmail == 'khalil@adityagreenenergy.com';
      let userData = getUserData();
      let hasAdminRole = userData.get('role', '') == 'Admin';
      return isSignedIn() && (isSuperAdmin || hasAdminRole);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPoints', 'hiddenPermitIds', 'starredProjectIds']))
      );
      allow delete: if isAdmin();
    }

    match /team_mapping_overrides/{overrideId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sites/{siteId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        (!('drawingUrl' in resource.data) || resource.data.drawingUrl == null) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['drawingUrl', 'drawingName', 'updatedAt'])
      );
    }

    match /site_groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /system_settings/access/roles/{roleId} {
      allow read, write: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /user_roles/{roleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentReading', 'updatedAt']));
    }

    match /project_boms/{bomId} {
      allow read, write: if isSignedIn();
    }

    match /project_pos/{poId} {
      allow read, write: if isSignedIn();
    }

    match /project_wos/{woId} {
      allow read, write: if isSignedIn();
    }

    match /project_inventory/{invId} {
      allow read, write: if isSignedIn();
    }

    match /master_inventory/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /inventory_categories/{categoryId} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        isAdmin() || 
        getUserData().get('department', '') == 'Account' ||
        getUserData().get('role', '') == 'Manager - Human Resources'
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || getUserData().get('department', '') == 'Account');
      allow delete: if isAdmin();
    }

    match /expense_categories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /table_configurations/{tableId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /mms_checklists/{checklistId} {
      allow read, write: if isSignedIn();
    }

    match /installation_checklists/{checklistId} {
      allow read, write: if isSignedIn();
    }

    match /vehicle_assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /site_visits/{visitId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.managerId == request.auth.uid);
    }

    function isParticipant(data) {
       return request.auth.uid == data.userId || request.auth.uid == data.siteManagerId || isAdmin();
    }

    match /permits_to_work/{permitId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.siteEngineerId == request.auth.uid || resource.data.siteManagerId == request.auth.uid));
    }

    match /dprs/{dprId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.siteManagerId || 
        isAdmin()
      );
    }

    match /requirements/{reqId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.siteManagerId || 
        isAdmin()
      );
    }

    match /material_movements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.siteManagerId || 
        isAdmin()
      );
    }

    match /material_utilisations/{utilId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.siteManagerId || 
        isAdmin()
      );
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isSignedIn();
    }

    match /makes/{makeId} {
      allow read, write: if isSignedIn();
    }

    match /contractors/{contractorId} {
      allow read, write: if isSignedIn();
    }
    
    match /contractor_roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (settingId == 'counters' && isSignedIn());
    }

    match /system_settings/access/roles/{roleId=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /site_documents/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uploadedById == request.auth.uid);
    }

    match /lms_courses/{courseId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /lms_modules/{moduleId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /lms_quizzes/{quizId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /lms_progress/{progressId} {
      allow read: if isSignedIn() && (isAdmin() || progressId.split('_')[0] == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /otp_verifications/{otpId} { allow read, write: if true; }
    match /redemption_requests/{requestId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /projects/{projectId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /notifications/{notifId} { allow read, write: if isSignedIn(); }
    match /point_adjustment_requests/{requestId} { allow read, write: if isAdmin(); }
    match /cleanup_requests/{requestId} { allow read, write: if isAdmin(); }
    
    match /ptw_types/{typeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }
  }
}
