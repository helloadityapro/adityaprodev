
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the PermitFlow application.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "mobile": { "type": "string" },
        "role": { "type": "string" },
        "registrationRequest": { "type": "boolean" },
        "siteManagerId": { "type": "string" },
        "assignedProjectIds": { "type": "array", "items": { "type": "string" } },
        "hiddenPermitIds": { "type": "array", "items": { "type": "string" } },
        "totalPoints": { "type": "number", "default": 0 },
        "pointsMultiplier": { "type": "number", "default": 1 }
      },
      "required": ["id", "username", "email", "mobile", "role"]
    },
    "Supplier": {
      "title": "Supplier",
      "type": "object",
      "description": "Information about material suppliers.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "gstin": { "type": "string" },
        "address": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "gstin", "mobile"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pointValueInRs": { "type": "number", "default": 1 },
        "ptwNoCorrection": { "type": "number", "default": 1 },
        "ptwWithCorrection": { "type": "number", "default": 0.5 },
        "movementEngineer": { "type": "number", "default": 0.1 },
        "movementManager": { "type": "number", "default": 0.05 },
        "dprEngineer": { "type": "number", "default": 0.1 },
        "dprManager": { "type": "number", "default": 0.05 },
        "taskAssignment": { "type": "number", "default": 0.1 },
        "taskCompletion": { "type": "number", "default": 0.1 }
      }
    },
    "PermitToWork": {
      "title": "PermitToWork",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serialNumber": { "type": "string" },
        "siteName": { "type": "string" },
        "ptwType": { "type": "string" },
        "descriptionOfWork": { "type": "string" },
        "status": { "type": "string" },
        "siteEngineerId": { "type": "string" },
        "siteEngineerName": { "type": "string" },
        "siteManagerId": { "type": "string" },
        "requestDate": { "type": "string", "format": "date-time" }
      },
      "required": ["siteName", "ptwType", "descriptionOfWork", "status", "siteEngineerId", "requestDate"]
    },
    "DPR": {
      "title": "Daily Progress Report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteName": { "type": "string" },
        "reportDate": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "siteManagerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "editedBy": { "type": "string" },
        "editedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteName", "reportDate", "description", "userId"]
    },
    "Requirement": {
      "title": "Site Requirement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteName": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "enum": ["Numbers", "Kilograms", "Liters", "Meters", "Sets"] },
        "urgency": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "expectedDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Pending", "ManagerApproved", "Approved", "Rejected", "Ordered", "Dispatched", "In-transit", "Delivered"] },
        "statusUpdatedBy": { "type": "string" },
        "statusUpdatedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "siteManagerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "editedBy": { "type": "string" },
        "editedAt": { "type": "string", "format": "date-time" },
        "timeline": { "type": "array" }
      },
      "required": ["siteName", "itemName", "quantity", "unit", "urgency", "expectedDate", "userId", "status"]
    },
    "MaterialMovement": {
      "title": "Material Movement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteName": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "movementType": { "type": "string", "enum": ["Inward", "Outward"] },
        "sourceOrDestination": { "type": "string" },
        "movementDate": { "type": "string", "format": "date" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "siteManagerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteName", "itemName", "quantity", "unit", "movementType", "movementDate", "userId", "sourceOrDestination"]
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedToId": { "type": "string" },
        "assignedToName": { "type": "string" },
        "assignedById": { "type": "string" },
        "assignedByName": { "type": "string" },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "status": { "type": "string", "enum": ["To-do", "In Progress", "Completed", "Cancelled"] },
        "dueDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "remarks": { "type": "string" }
      },
      "required": ["siteName", "title", "assignedToId", "priority", "status", "dueDate"]
    },
    "CleanupRequest": {
      "title": "Cleanup Request",
      "type": "object",
      "description": "Administrative request to purge all data for a specific user.",
      "properties": {
        "id": { "type": "string" },
        "targetEmail": { "type": "string" },
        "requestedById": { "type": "string" },
        "requestedByName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User" }
      },
      {
        "path": "/suppliers/{supplierId}",
        "definition": { "entityName": "Supplier" }
      },
      {
        "path": "/system_settings/{settingId}",
        "definition": { "entityName": "SystemSettings" }
      },
      {
        "path": "/permits_to_work/{permitId}",
        "definition": { "entityName": "PermitToWork" }
      },
      {
        "path": "/dprs/{dprId}",
        "definition": { "entityName": "DPR" }
      },
      {
        "path": "/requirements/{reqId}",
        "definition": { "entityName": "Requirement" }
      },
      {
        "path": "/material_movements/{movementId}",
        "definition": { "entityName": "MaterialMovement" }
      },
      {
        "path": "/tasks/{taskId}",
        "definition": { "entityName": "Task" }
      },
      {
        "path": "/cleanup_requests/{requestId}",
        "definition": { "entityName": "CleanupRequest" }
      }
    ]
  }
}
