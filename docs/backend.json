
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the PermitFlow application.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "mobile": { "type": "string" },
        "role": { "type": "string", "description": "Dynamic role assigned from user_roles collection." },
        "department": { "type": "string", "description": "Dynamic department assigned from user_departments collection." },
        "registrationRequest": { "type": "boolean" },
        "siteManagerId": { "type": "string" },
        "assignedProjectIds": { "type": "array", "items": { "type": "string" } },
        "hiddenPermitIds": { "type": "array", "items": { "type": "string" } },
        "totalPoints": { "type": "number", "default": 0 },
        "pointsMultiplier": { "type": "number", "default": 1 }
      },
      "required": ["id", "username", "email", "mobile", "role"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "plateNumber": { "type": "string" },
        "ownership": { "type": "string", "enum": ["Owned", "Rented"] },
        "currentReading": { "type": "number" },
        "status": { "type": "string", "enum": ["Available", "Assigned", "Maintenance"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "VehicleAssignment": {
      "title": "Vehicle Assignment / Trip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "vehicleId": { "type": "string" },
        "vehicleDetails": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Ongoing", "Completed", "Rejected"] },
        "requestDate": { "type": "string", "format": "date-time" },
        "startTime": { "type": "string", "format": "date-time" },
        "startReading": { "type": "number" },
        "startReadingPhoto": { "type": "string" },
        "endTime": { "type": "string", "format": "date-time" },
        "endReading": { "type": "number" },
        "endReadingPhoto": { "type": "string" }
      }
    },
    "UserRole": {
      "title": "User Role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "UserDepartment": {
      "title": "User Department",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles and roles."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/backend/entities/Vehicle" },
      "description": "Organizational vehicle registry."
    },
    "/vehicle_assignments/{assignmentId}": {
      "schema": { "$ref": "#/backend/entities/VehicleAssignment" },
      "description": "Trip requests and execution logs."
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/backend/entities/Attendance" },
      "description": "Daily check-in and check-out logs."
    },
    "/user_roles/{roleId}": {
      "schema": { "$ref": "#/backend/entities/UserRole" },
      "description": "Dynamic organization roles."
    },
    "/user_departments/{deptId}": {
      "schema": { "$ref": "#/backend/entities/UserDepartment" },
      "description": "Dynamic organization departments."
    }
  }
}
