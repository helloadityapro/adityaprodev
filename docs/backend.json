
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the Aditya Pro application.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "mobile": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "dob": { "type": "string", "format": "date", "description": "Date of Birth" },
        "doj": { "type": "string", "format": "date", "description": "Date of Joining" },
        "aadharNumber": { "type": "string", "description": "12-digit Aadhar Number" },
        "panNumber": { "type": "string", "description": "10-character PAN Number" },
        "registrationRequest": { "type": "boolean" },
        "siteManagerId": { "type": "string" },
        "assignedProjectIds": { "type": "array", "items": { "type": "string" } },
        "hiddenPermitIds": { "type": "array", "items": { "type": "string" } },
        "fcmTokens": { "type": "array", "items": { "type": "string" }, "description": "FCM registration tokens for push notifications" },
        "totalPoints": { "type": "number", "default": 0 },
        "pointsMultiplier": { "type": "number", "default": 1 },
        "customPermissions": { "type": "array", "items": { "type": "string" }, "description": "Individual access overrides for sidebar pages" },
        "ownDataOnly": { "type": "boolean", "default": false, "description": "Strictly limit user to assigned projects only" },
        "suspended": { "type": "boolean", "default": false, "description": "Whether the user account is suspended and excluded from active attendance reporting" }
      },
      "required": ["id", "username", "email", "mobile", "role"]
    },
    "TeamMappingOverride": {
      "title": "Team Mapping Override",
      "type": "object",
      "description": "Optional site-specific manager overrides for individual engineers.",
      "properties": {
        "id": { "type": "string" },
        "engineerId": { "type": "string" },
        "siteId": { "type": "string" },
        "managerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["engineerId", "siteId", "managerId"]
    },
    "Site": {
      "title": "Project Site",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "projectCompany": { "type": "string" },
        "projectType": { "type": "string", "enum": ["groundmount", "rooftop"], "default": "groundmount" },
        "acCapacity": { "type": "number" },
        "dcCapacity": { "type": "number" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "drawingUrl": { "type": "string", "description": "URL to the Table Numbering Drawing PDF" },
        "drawingName": { "type": "string", "description": "Original filename of the drawing" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "projectCompany", "projectType"]
    },
    "SiteGroup": {
      "title": "Site Group",
      "type": "object",
      "description": "Custom grouping of project sites for filtering and reporting.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "siteIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdById": { "type": "string" }
      },
      "required": ["name", "siteIds"]
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "link": { "type": "string" },
        "read": { "type": "boolean", "default": false },
        "push": { "type": "boolean", "default": false, "description": "Whether to send as a system push notification" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "description"]
    },
    "AccessRule": {
      "title": "Access Rule",
      "type": "object",
      "description": "Role-based page access configuration.",
      "properties": {
        "id": { "type": "string", "description": "The role name" },
        "allowedPageKeys": { "type": "array", "items": { "type": "string" } },
        "ownDataOnly": { "type": "boolean", "default": false, "description": "Default data sovereignty for this role" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Quote": {
      "title": "Motivational Quote",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "plateNumber": { "type": "string" },
        "ownership": { "type": "string", "enum": ["Owned", "Rented"] },
        "currentReading": { "type": "number" },
        "status": { "type": "string", "enum": ["Available", "Allotted", "Ongoing"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Supplier": {
      "title": "Supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "gstin": { "type": "string" },
        "address": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name"]
    },
    "Make": {
      "title": "Make / Manufacturer",
      "type": "object",
      "description": "Manufacturer / Brand registry.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "gstin": { "type": "string" },
        "address": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name"]
    },
    "Contractor": {
      "title": "Contractor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bankingDetails": { "type": "string" },
        "gstin": { "type": "string" },
        "address": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name", "role"]
    },
    "ContractorRole": {
      "title": "Contractor Role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "InverterMake": {
      "title": "Inverter Manufacturer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "InverterRating": {
      "title": "Inverter Rating",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "BoMItem": {
      "title": "BoM Item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "itemName": { "type": "string" },
        "specification": { "type": "string" },
        "plannedQuantity": { "type": "number" },
        "approvedQuantity": { "type": "number" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "subItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "quantityPerSet": { "type": "number" },
              "unit": { "type": "string" }
            }
          }
        }
      }
    },
    "PurchaseOrder": {
      "title": "Purchase Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "poNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "orderDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Open", "Partial", "Received", "Cancelled"] },
        "totalAmount": { "type": "number" }
      }
    },
    "WorkOrder": {
      "title": "Work Order",
      "type": "object",
      "description": "Service contracts for contractors.",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "projectCompany": { "type": "string" },
        "woNumber": { "type": "string" },
        "contractorId": { "type": "string" },
        "contractorName": { "type": "string" },
        "contractorAddress": { "type": "string" },
        "contractorGST": { "type": "string" },
        "orderDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Cancelled"] },
        "totalAmount": { "type": "number" },
        "totalBasicAmount": { "type": "number" },
        "totalGstAmount": { "type": "number" },
        "description": { "type": "string" },
        "termsAndConditions": { "type": "string" },
        "issuerType": { "type": "string", "enum": ["Aditya", "Client"] },
        "isManualSubject": { "type": "boolean" },
        "subject": { "type": "string" }
      },
      "required": ["woNumber", "contractorId", "totalAmount"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "itemName": { "type": "string" },
        "stockLevel": { "type": "number" },
        "utilisedQuantity": { "type": "number", "default": 0 },
        "unit": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "MaterialUtilisation": {
      "title": "Material Utilisation",
      "type": "object",
      "description": "Records of material consumption on site.",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "utilisationDate": { "type": "string", "format": "date" },
        "remarks": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteId", "itemName", "quantity", "utilisationDate"]
    },
    "MasterInventoryItem": {
      "title": "Master Inventory Item",
      "type": "object",
      "description": "Global registry of items and assets.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "make": { "type": "string" },
        "subItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "quantityPerSet": { "type": "number" },
              "unit": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "unit", "make"]
    },
    "InventoryCategory": {
      "title": "Inventory Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Expense": {
      "title": "Expense Submission",
      "type": "object",
      "description": "Reimbursement claims and official expenditure logs.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "title": { "type": "string" },
        "siteName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Paid"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "description": { "type": "string" },
              "amount": { "type": "number" },
              "date": { "type": "string" },
              "receiptUrl": { "type": "string" }
            }
          }
        },
        "adminRemarks": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "totalAmount"]
    },
    "ExpenseCategory": {
      "title": "Expense Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "TableConfiguration": {
      "title": "Table Configuration",
      "type": "object",
      "description": "Definition of solar module mounting tables for specific sites.",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "tableName": { "type": "string" },
        "bomItemId": { "type": "string" },
        "configurationType": { "type": "string" },
        "modulesPerTable": { "type": "number" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "quantityPerSet": { "type": "number" },
              "unit": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteId", "tableName", "bomItemId", "modulesPerTable"]
    },
    "MMSChecklist": {
      "title": "MMS Checklist",
      "type": "object",
      "description": "Table-level verification for Mounting Structures.",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "tableId": { "type": "string" },
        "tableName": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "object": {
              "properties": {
                "name": { "type": "string" },
                "checked": { "type": "boolean" },
                "remarks": { "type": "string" }
              }
            }
          }
        },
        "generalRemarks": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteId", "tableId", "userId"]
    },
    "InstallationChecklist": {
      "title": "Installation Checklist",
      "type": "object",
      "description": "General site installation verification checklist.",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "tableNumber": { "type": "string" },
        "tableSize": { "type": "string" },
        "columnCount": { "type": "number" },
        "moduleCount": { "type": "number" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "remarks": { "type": "string" },
              "photoUrl": { "type": "string" },
              "status": { "type": "string", "enum": ["OK", "NOT OK", "Pending"] }
            }
          }
        },
        "otherRemarks": { "type": "string" },
        "customerRepPresent": { "type": "boolean" },
        "customerRepName": { "type": "string" },
        "customerRepRemarks": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"], "default": "Pending" },
        "ptwStatus": { "type": "string", "enum": ["Open", "Closed"], "default": "Open" },
        "closureStep": { "type": "string", "enum": ["Engineer", "Manager", "Admin", "Completed"], "default": "Engineer" },
        "adminRemarks": { "type": "string" },
        "processedBy": { "type": "string" },
        "processedByName": { "type": "string" },
        "processedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteId", "tableNumber", "userId"]
    },
    "InverterChecklist": {
      "title": "Inverter Checklist",
      "type": "object",
      "description": "Verification of inverter installation and stringing.",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "projectCompany": { "type": "string" },
        "inverterMake": { "type": "string" },
        "inverterRating": { "type": "string" },
        "inverterNumber": { "type": "string" },
        "inverterSerialNumber": { "type": "string" },
        "stringCount": { "type": "number" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "remarks": { "type": "string" },
              "attachments": { "type": "array", "items": { "type": "object" } },
              "status": { "type": "string", "enum": ["OK", "NOT OK", "Pending"] }
            }
          }
        },
        "otherRemarks": { "type": "string" },
        "otherAttachments": { "type": "array", "items": { "type": "object" } },
        "customerRepPresent": { "type": "boolean" },
        "customerRepName": { "type": "string" },
        "customerRepRemarks": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"], "default": "Pending" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteId", "inverterNumber", "userId"]
    },
    "HTLineChecklist": {
      "title": "HT Line Checklist",
      "type": "object",
      "description": "Verification of High Tension line poles and components.",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "projectCompany": { "type": "string" },
        "poleType": { "type": "string", "enum": ["Two Pole", "Four Pole"] },
        "poleNumber": { "type": "string" },
        "poleSize": { "type": "string" },
        "cutPointType": { "type": "string", "enum": ["Single Cut Point", "Double Cut Point"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "status": { "type": "string", "enum": ["Yes", "No"] },
              "quantity": { "type": "number" },
              "remarks": { "type": "string" },
              "attachments": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "additionalRemarks": { "type": "string" },
        "generalPhotos": { "type": "array", "items": { "type": "object" } },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"], "default": "Pending" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteId", "poleNumber", "userId"]
    },
    "HTConductorChecklist": {
      "title": "HT Conductor Checklist",
      "type": "object",
      "description": "Sequential pole distance verification for HT conductors.",
      "properties": {
        "id": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "projectCompany": { "type": "string" },
        "poleConfiguration": { "type": "string", "enum": ["Two Pole", "Four Pole"] },
        "spans": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "distance": { "type": "number" }
            }
          }
        },
        "status": { "type": "string", "enum": ["Draft", "Pending", "Approved", "Rejected"] },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteId", "poleConfiguration", "userId"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles and performance data."
    },
    "/team_mapping_overrides/{overrideId}": {
      "schema": { "$ref": "#/backend/entities/TeamMappingOverride" },
      "description": "Site-specific manager overrides for engineers."
    },
    "/sites/{siteId}": {
      "schema": { "$ref": "#/backend/entities/Site" },
      "description": "Project site locations and capacities."
    },
    "/site_groups/{groupId}": {
      "schema": { "$ref": "#/backend/entities/SiteGroup" },
      "description": "Categorization of sites for filtering."
    },
    "/system_settings/access/roles/{roleId}": {
      "schema": { "$ref": "#/backend/entities/AccessRule" },
      "description": "Role-based access permissions."
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/backend/entities/Quote" },
      "description": "Motivational quotes displayed during loading."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/backend/entities/Vehicle" },
      "description": "Fleet registry."
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/backend/entities/Supplier" },
      "description": "Material supplier registry."
    },
    "/makes/{makeId}": {
      "schema": { "$ref": "#/backend/entities/Make" },
      "description": "Manufacturer / Brand registry."
    },
    "/contractors/{contractorId}": {
      "schema": { "$ref": "#/backend/entities/Contractor" },
      "description": "Service contractor registry."
    },
    "/contractor_roles/{roleId}": {
      "schema": { "$ref": "#/backend/entities/ContractorRole" },
      "description": "Registry of contractor types/roles."
    },
    "/inverter_makes/{makeId}": {
      "schema": { "$ref": "#/backend/entities/InverterMake" },
      "description": "Registry of Inverter Manufacturers."
    },
    "/inverter_ratings/{ratingId}": {
      "schema": { "$ref": "#/backend/entities/InverterRating" },
      "description": "Registry of Inverter Capacities."
    },
    "/project_boms/{bomId}": {
      "schema": { "$ref": "#/backend/entities/BoMItem" },
      "description": "Bill of Materials per project site."
    },
    "/project_pos/{poId}": {
      "schema": { "$ref": "#/backend/entities/PurchaseOrder" },
      "description": "Purchase orders associated with project sites."
    },
    "/project_wos/{woId}": {
      "schema": { "$ref": "#/backend/entities/WorkOrder" },
      "description": "Work orders for contractors per project site."
    },
