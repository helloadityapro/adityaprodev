
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the Aditya Pro application.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "mobile": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "registrationRequest": { "type": "boolean" },
        "siteManagerId": { "type": "string" },
        "assignedProjectIds": { "type": "array", "items": { "type": "string" } },
        "totalPoints": { "type": "number", "default": 0 },
        "pointsMultiplier": { "type": "number", "default": 1 }
      },
      "required": ["id", "username", "email", "mobile", "role"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "plateNumber": { "type": "string" },
        "ownership": { "type": "string", "enum": ["Owned", "Rented"] },
        "currentReading": { "type": "number" },
        "status": { "type": "string", "enum": ["Available", "Assigned", "Maintenance"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Expense": {
      "title": "Expense Report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["Site", "General"] },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "HR_Approved", "Approved", "Rejected", "Paid"] },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "category": { "type": "string" },
              "description": { "type": "string" },
              "amount": { "type": "number" },
              "proofUrl": { "type": "string" }
            }
          }
        },
        "remarks": { "type": "string" },
        "paymentDetails": {
          "type": "object",
          "properties": {
            "transactionId": { "type": "string" },
            "paymentDate": { "type": "string", "format": "date-time" },
            "paidBy": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles and performance data."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/backend/entities/Vehicle" },
      "description": "Fleet registry."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/backend/entities/Expense" },
      "description": "Organizational expense tracking and approval workflow."
    }
  }
}
